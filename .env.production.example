# Production template (Phase 5). Copy to .env on the host, fill the blanks,
# then run: php artisan key:generate && php artisan app:check-production
# Never commit the real .env. Values marked "verify" depend on the host.

APP_NAME="سجاد معصومی"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sajadmasoumi.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_MAINTENANCE_DRIVER=file

# A less guessable panel path (letters, digits, hyphen). Not listed in robots.txt (D25).
ADMIN_PATH=

QUEUE_CONNECTION=sync
CACHE_STORE=file

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=sm_session
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP=true
SECURITY_CSP_REPORT_ONLY=false
# Only if a CDN / reverse proxy sits in front of the site (verify). Empty = none.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# Backups (php artisan app:backup; daily via the schedule:run cron). Files stay in
# storage/app/backups — download copies off the server regularly (D35).
BACKUP_KEEP=14
BACKUP_KEEP_MEDIA=4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB created in DirectAdmin (verify version: MySQL ≥ 5.7 or MariaDB ≥ 10.3).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Outgoing mail is not used by v1 (messages are stored in the panel); keep "log"
# until SMTP is confirmed with the host (verify).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@sajadmasoumi.com"
MAIL_FROM_NAME="${APP_NAME}"
