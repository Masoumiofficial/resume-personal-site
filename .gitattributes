* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Not part of the release package built by .github/workflows/release.yml (D39):
# development, documentation and lab tooling never go to the host.
/tests export-ignore
/docs export-ignore
/design export-ignore
/tools export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
