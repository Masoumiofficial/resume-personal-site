# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (this repository is public).
# Production values: see docs/deployment (Phase 6). Generate APP_KEY with
#   php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME="سجاد معصومی"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Dates are STORED in UTC (config/app.php timezone) and DISPLAYED in this zone.
APP_DISPLAY_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file

# Admin panel URL prefix (letters, digits, dashes). Changing it only reduces bot
# noise — it is NOT access control. Auth + 2FA protect the panel.
ADMIN_PATH=admin

# Shared hosting: no Redis, no workers. Work runs synchronously.
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# In production behind HTTPS set to true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Security headers (app/Http/Middleware/SecurityHeaders.php)
# HSTS is only sent on HTTPS requests in production.
SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production (DirectAdmin MySQL/MariaDB):
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@sajadmasoumi.com"
MAIL_FROM_NAME="${APP_NAME}"
